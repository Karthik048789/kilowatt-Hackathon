# ==========================================
# SmartPIM AI Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database: MongoDB Atlas
# Provide your MongoDB Atlas Connection String below:
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartpim?retryWrites=true&w=majority
# Leave blank or unconfigured to automatically use the persistent local JSON database.
MONGODB_URI=

# WooCommerce REST API v3 Integration
# Leave blank or unconfigured to automatically run in DEMO MODE with safe schema validation.
WOOCOMMERCE_URL=https://your-woocommerce-store.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AI Agent Configuration
# Select provider: 'autonomous_engine' (local built-in) | 'gemini' | 'openai'
AI_PROVIDER=autonomous_engine

# Optional: Google Gemini API Key (for Live Gemini 1.5 Flash Function Calling)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (for Live GPT-4o-mini Tool Calling)
OPENAI_API_KEY=your_openai_api_key_here
